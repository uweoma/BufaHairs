# =============================================================================
# BufaHairs — Root environment reference
# Copy to `.env` for docker-compose, and see backend/.env.example &
# frontend/.env.example for per-service variables.
# NEVER commit real secrets. This file documents placeholders only.
# =============================================================================

# ---------- PostgreSQL (used by docker-compose) ----------
POSTGRES_USER=bufahairs
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=bufahairs
POSTGRES_PORT=5432

# ---------- Backend ----------
# When running via docker-compose the host is the service name `postgres`.
DATABASE_URL=postgresql://bufahairs:change_me_in_production@postgres:5432/bufahairs?schema=public
NODE_ENV=development
PORT=4000

# JWT — generate strong random values, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies / CORS
COOKIE_DOMAIN=localhost
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---------- Paystack (get test keys at https://dashboard.paystack.com) ----------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_URL=http://localhost:4000/api/payments/webhook

# ---------- Cloudinary (image storage — optional in dev) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Resend (transactional email — optional in dev) ----------
RESEND_API_KEY=
EMAIL_FROM="BufaHairs <noreply@bufahairs.test>"

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
NEXT_PUBLIC_BRAND_NAME=BufaHairs
