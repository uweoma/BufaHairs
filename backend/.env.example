# ---------- Runtime ----------
NODE_ENV=development
PORT=4000

# ---------- Database ----------
# Local (no docker):  postgresql://bufahairs:bufahairs@localhost:5432/bufahairs?schema=public
# Docker compose:     postgresql://bufahairs:...@postgres:5432/bufahairs?schema=public
DATABASE_URL=postgresql://bufahairs:bufahairs@localhost:5432/bufahairs?schema=public

# ---------- JWT (generate with: openssl rand -base64 48) ----------
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- CORS / cookies ----------
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost

# ---------- Paystack ----------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Cloudinary (optional in dev) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Resend email (optional in dev) ----------
RESEND_API_KEY=
EMAIL_FROM="BufaHairs <noreply@bufahairs.test>"

# ---------- Seed credentials ----------
# Optional in dev (falls back to local defaults). REQUIRED when NODE_ENV=production:
# the seed refuses to run in production unless SEED_ADMIN_EMAIL + SEED_ADMIN_PASSWORD are set.
# Use strong, unique values on any reachable deployment — never the dev defaults.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=
SEED_CUSTOMER_PASSWORD=
