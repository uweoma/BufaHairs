# BufaHairs — frontend environment (Next.js). Public vars are exposed to the browser.
# Copy to `.env.local` for local dev.

# Base URL of the backend REST API (include the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL — used for SEO canonical/OG tags, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack PUBLIC key (safe to expose). Leave blank to hide inline card fields;
# checkout still works via the backend-generated authorization URL redirect.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# WhatsApp contact (international format, no +). Empty hides the floating button.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Brand name (lets you re-skin without code changes).
NEXT_PUBLIC_BRAND_NAME=BufaHairs
